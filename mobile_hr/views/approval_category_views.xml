<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form_inherit_mobile_hr" model="ir.ui.view">
        <field name="name">approval.category.view.form.inherit.mobile.hr</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='has_period']" position="attributes">
                <attribute name="readonly">approval_type == 'attendance'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='has_amount']" position="attributes">
                <attribute name="readonly">approval_type == 'advance_salary'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
