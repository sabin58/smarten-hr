<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_simple_modif_nepali_date_preference" model="ir.ui.view">
        <field name="name">res.users.preferences.form.nepali.date.preference</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="nepali_date_calendar_preference" widget="radio" options="{'horizontal': true}"/>
            </xpath>
        </field>
    </record>
</odoo>
